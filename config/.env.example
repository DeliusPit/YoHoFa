# Both values are required in production; the backend will not start if either is empty.
AUTH_USERNAME=
AUTH_PASSWORD=

# SQLite files configured through storage.json must remain below this absolute path.
DATABASE_DATA_ROOT=/app/data/sqlite

# Optional MySQL bootstrap settings. Normal changes belong in storage.json via the UI.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=geldzaken
MYSQL_USER=geldzaken
MYSQL_PASSWORD=
MYSQL_TLS_MODE=disabled

# Optional provider-neutral bootstrap overrides. Normal changes belong in storage.json via the UI.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=geldzaken-documents
S3_USE_TLS=false
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_CREATE_BUCKET=false
