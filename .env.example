# Production authentication (required). Fill in locally, never commit .env.
AUTH_USERNAME=
AUTH_PASSWORD=

# Existing Garage/S3 endpoint, reachable from the Compose network.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=yohofa-docs
S3_USE_TLS=false
S3_REGION=garage
S3_PATH_STYLE=true
S3_CREATE_BUCKET=false

# AI endpoints.
PDF_AI_URL=
PDF_AI_MODEL=Qwen3.8-Flash-Next-UD-Q4_K_XL
TRANSACTION_AI_URL=
TRANSACTION_AI_MODEL=Qwen3.6-35B-A3B-Q4_K_M
